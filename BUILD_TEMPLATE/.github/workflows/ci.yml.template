name: CI

# CI workflow for basic verification
# All builds are done locally - see CONTRIBUTING.md for build instructions
#
# Configuration:
#   MAIN_BRANCH     - Main branch name (default: "main")
#   DEVELOP_BRANCH  - Develop branch name (default: "develop")
#   BUILD_DIR       - Build output directory (default: "build")
#   TARGET_NAME     - Executable name (default: "{{TARGET_NAME}}")
#   TEST_COMMAND    - Test command (default: "make test")

on:
  push:
    branches: [ {{MAIN_BRANCH}}, {{DEVELOP_BRANCH}} ]
  pull_request:
    branches: [ {{MAIN_BRANCH}}, {{DEVELOP_BRANCH}} ]

jobs:
  verify:
    name: Verify (Linux)
    runs-on: ubuntu-latest
    
    strategy:
      matrix:
        compiler: [gcc, clang]
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
    
    - name: Set up compiler
      run: |
        if [ "${{ matrix.compiler }}" = "clang" ]; then
          sudo apt-get update
          sudo apt-get install -y clang
        fi
    
    - name: Build
      run: |
        if [ "${{ matrix.compiler }}" = "clang" ]; then
          make CC=clang
        else
          make
        fi
    
    - name: Run tests
      run: {{TEST_COMMAND}}
      continue-on-error: true
    
    - name: Check executable
      run: |
        ./{{BUILD_DIR}}/{{TARGET_NAME}} -h || true
        test -f {{BUILD_DIR}}/{{TARGET_NAME}}
